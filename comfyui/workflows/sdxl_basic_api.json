{
  "_note": "Reference SDXL text-to-image graph in ComfyUI's API ('prompt') format. The same graph is built dynamically inside workflows/02_ai_visual_studio.json. Keep this file as a template for customisations (e.g. swap to Flux, add ControlNet).",
  "_test": "POST this object (wrapped under {\"prompt\": ...}) to http://comfyui:8188/prompt to verify ComfyUI is healthy independently of n8n.",
  "4": { "class_type": "CheckpointLoaderSimple", "inputs": { "ckpt_name": "sd_xl_base_1.0.safetensors" } },
  "5": { "class_type": "EmptyLatentImage",       "inputs": { "width": 1024, "height": 1024, "batch_size": 1 } },
  "6": { "class_type": "CLIPTextEncode",         "inputs": { "text": "studio mockup, soft lighting, high detail", "clip": ["4", 1] } },
  "7": { "class_type": "CLIPTextEncode",         "inputs": { "text": "low quality, blurry, watermark, text",      "clip": ["4", 1] } },
  "3": { "class_type": "KSampler",
          "inputs": { "seed": 42, "steps": 25, "cfg": 7.0,
                      "sampler_name": "euler", "scheduler": "normal", "denoise": 1,
                      "model":        ["4", 0],
                      "positive":     ["6", 0],
                      "negative":     ["7", 0],
                      "latent_image": ["5", 0] } },
  "8": { "class_type": "VAEDecode",  "inputs": { "samples": ["3", 0], "vae": ["4", 2] } },
  "9": { "class_type": "SaveImage",  "inputs": { "filename_prefix": "etsy/sample", "images": ["8", 0] } }
}

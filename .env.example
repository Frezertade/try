# =============================================================================
# Etsy AI Self-Hosted Dashboard — environment variables
# Copy to .env and fill in. Never commit .env.
# Generate secrets with: openssl rand -hex 32   (or 64 where noted)
# =============================================================================

# ---- Postgres ---------------------------------------------------------------
POSTGRES_USER=etsy
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=etsy_app

# ---- n8n --------------------------------------------------------------------
# 32-byte hex. CRITICAL: rotating this invalidates all stored credentials.
N8N_ENCRYPTION_KEY=replace_with_openssl_rand_hex_32
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_me
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=UTC

# Shared secret for protected webhooks (workflows 01, 02, 03, 04a, 05, 07).
# Clients must send 'X-Webhook-Secret: <this value>' on every call.
# Public routes (Etsy OAuth callback, mockup-view image proxy) are exempt.
# 32-byte hex
N8N_WEBHOOK_SECRET=replace_with_openssl_rand_hex_32

# ---- ToolJet ----------------------------------------------------------------
# 64-byte hex
TOOLJET_SECRET_KEY_BASE=replace_with_openssl_rand_hex_64
# 32-byte hex
TOOLJET_LOCKBOX_KEY=replace_with_openssl_rand_hex_32
TOOLJET_HOST=http://localhost:3000
TOOLJET_PORT=3000

# ---- Ollama -----------------------------------------------------------------
# Comma-separated list pulled by scripts/pull-models.sh
OLLAMA_MODELS=mistral:7b-instruct-q4_K_M,qwen2.5:7b-instruct-q4_K_M

# ---- ComfyUI ----------------------------------------------------------------
COMFYUI_PORT=8188

# ---- Etsy API (fill after creating an Etsy developer app) -------------------
# https://www.etsy.com/developers/your-apps
ETSY_CLIENT_ID=
ETSY_CLIENT_SECRET=
ETSY_REDIRECT_URI=http://localhost:5678/webhook/etsy-oauth-callback

# ---- POD providers (optional; needed for orders 2.0) ------------------------
PRINTIFY_API_KEY=
PRINTFUL_API_KEY=

# ---- Promotion scheduler (workflow 08) --------------------------------------
# Per-channel outgoing webhook URLs. Workflow 08 POSTs the queued post body
# (post_id, listing_id, channel, copy, image_path, scheduled_for) to whichever
# of these is set. Leave blank to keep posts in status='ready_for_export' for
# manual handling from the ToolJet AI Ads Studio tab.
# Examples: a Buffer/Make.com/Zapier endpoint, or another n8n workflow's
# webhook URL that owns the channel-specific OAuth.
PINTEREST_WEBHOOK_URL=
X_WEBHOOK_URL=
INSTAGRAM_WEBHOOK_URL=

# ---- Reverse proxy (optional) -----------------------------------------------
# Used by caddy/Caddyfile when running with --profile proxy
PUBLIC_DOMAIN=example.com
LETSENCRYPT_EMAIL=admin@example.com

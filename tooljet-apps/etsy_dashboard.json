{
  "$schema": "https://docs.tooljet.com/schemas/app-export.v2.json",
  "_note": "ToolJet's exported app JSON is large and version-coupled. This file is a build spec: a stable description of the app's pages, components, queries, and constants. After installing ToolJet CE, create the app manually using the spec below (or use ToolJet's Import App with a real export from your instance once one tab is built). All component IDs are advisory.",
  "app": {
    "name": "Etsy AI Self-Hosted Dashboard",
    "slug": "etsy-ai-dashboard",
    "isPublic": false
  },
  "workspace_constants": [
    {
      "name": "N8N_URL",
      "value": "http://n8n:5678",
      "scope": "global",
      "_note": "Override per-environment. Use the Docker service name when ToolJet calls n8n inside the compose network."
    },
    {
      "name": "N8N_WEBHOOK_SECRET",
      "value": "set_to_match_n8n_env",
      "scope": "global",
      "_note": "Must match the N8N_WEBHOOK_SECRET env var in the n8n container. Sent as X-Webhook-Secret on every n8n_api call."
    },
    {
      "name": "DEFAULT_SHOP_ID",
      "value": "1",
      "scope": "global"
    }
  ],
  "data_sources": [
    {
      "name": "etsy_app_db",
      "kind": "postgresql",
      "options": {
        "host": "postgres",
        "port": 5432,
        "database": "etsy_app",
        "username": "${POSTGRES_USER}",
        "password": "${POSTGRES_PASSWORD}",
        "ssl_enabled": false
      }
    },
    {
      "name": "n8n_api",
      "kind": "restapi",
      "options": {
        "base_url": "{{constants.N8N_URL}}",
        "headers": [
          { "key": "Content-Type",    "value": "application/json" },
          { "key": "X-Webhook-Secret", "value": "{{constants.N8N_WEBHOOK_SECRET}}" }
        ]
      }
    }
  ],
  "queries": [
    {
      "name": "list_shops",
      "data_source": "etsy_app_db",
      "kind": "postgresql",
      "options": { "query": "SELECT id, name FROM shops ORDER BY id;" },
      "run_on_page_load": true
    },
    {
      "name": "list_listings",
      "data_source": "etsy_app_db",
      "kind": "postgresql",
      "options": {
        "query": "SELECT l.id, l.title, l.price, l.status, l.created_at, p.niche, p.kind, s.name AS shop FROM listings l JOIN products p ON p.id=l.product_id JOIN shops s ON s.id=p.shop_id ORDER BY l.created_at DESC LIMIT 100;"
      },
      "run_on_page_load": true
    },
    {
      "name": "kpi_today",
      "data_source": "etsy_app_db",
      "kind": "postgresql",
      "options": {
        "query": "SELECT COALESCE(SUM(o.total),0) AS revenue, COUNT(*) AS orders, COALESCE(SUM(CASE WHEN p.kind = 'printable' THEN o.total * 0.95 ELSE o.total - COALESCE(p.cost,0) END),0) AS profit FROM orders o LEFT JOIN shops s ON s.id = o.shop_id LEFT JOIN products p ON p.shop_id = s.id WHERE o.created_at::date = CURRENT_DATE;"
      },
      "run_on_page_load": true
    },
    {
      "name": "generate_listing",
      "data_source": "n8n_api",
      "kind": "restapi",
      "options": {
        "method": "post",
        "url_path": "/webhook/listing-generate",
        "body_toggle": true,
        "json_body": {
          "shop_id": "{{components.shopSelect.value}}",
          "niche": "{{components.nicheInput.value}}",
          "kind": "{{components.kindSelect.value}}",
          "cost": "{{components.costInput.value || 0}}"
        }
      },
      "run_on_page_load": false
    },
    {
      "name": "publish_listing",
      "data_source": "n8n_api",
      "kind": "restapi",
      "options": {
        "method": "post",
        "url_path": "/webhook/etsy-listing-publish",
        "body_toggle": true,
        "json_body": { "listing_id": "{{queries.generate_listing.data.listing.id}}" }
      },
      "run_on_page_load": false
    },
    {
      "name": "list_listings_for_visual",
      "data_source": "etsy_app_db",
      "kind": "postgresql",
      "options": {
        "query": "SELECT l.id, l.title FROM listings l ORDER BY l.created_at DESC LIMIT 200;"
      },
      "run_on_page_load": true
    },
    {
      "name": "list_mockups",
      "data_source": "etsy_app_db",
      "kind": "postgresql",
      "options": {
        "query": "SELECT m.id, m.listing_id, l.title, m.prompt, m.file_path, m.created_at FROM mockups m JOIN listings l ON l.id = m.listing_id ORDER BY m.created_at DESC LIMIT 50;"
      },
      "run_on_page_load": true
    },
    {
      "name": "generate_visual",
      "data_source": "n8n_api",
      "kind": "restapi",
      "options": {
        "method": "post",
        "url_path": "/webhook/visual-generate",
        "body_toggle": true,
        "json_body": {
          "listing_id": "{{components.visualListingSelect.value}}",
          "prompt": "{{components.visualPromptInput.value || null}}",
          "width":  "{{Number(components.visualSizeSelect.value || 1024)}}",
          "height": "{{Number(components.visualSizeSelect.value || 1024)}}",
          "checkpoint": "{{components.visualCheckpointSelect.value || 'sd_xl_base_1.0.safetensors'}}"
        }
      },
      "run_on_page_load": false,
      "options_extra": { "timeout_ms": 360000 }
    },
    {
      "name": "list_listings_for_ads",
      "data_source": "etsy_app_db",
      "kind": "postgresql",
      "options": {
        "query": "SELECT l.id, l.title FROM listings l ORDER BY l.created_at DESC LIMIT 200;"
      },
      "run_on_page_load": true
    },
    {
      "name": "list_scheduled_posts",
      "data_source": "etsy_app_db",
      "kind": "postgresql",
      "options": {
        "query": "SELECT sp.id, sp.listing_id, l.title, sp.channel, sp.status, sp.scheduled_for, LEFT(sp.copy, 120) AS preview FROM scheduled_posts sp JOIN listings l ON l.id = sp.listing_id ORDER BY sp.scheduled_for DESC LIMIT 100;"
      },
      "run_on_page_load": true
    },
    {
      "name": "generate_ads",
      "data_source": "n8n_api",
      "kind": "restapi",
      "options": {
        "method": "post",
        "url_path": "/webhook/ads-generate",
        "body_toggle": true,
        "json_body": {
          "listing_id": "{{components.adsListingSelect.value}}",
          "channels": "{{components.adsChannelsMulti.value}}",
          "generate_visual": "{{components.adsGenerateVisual.value}}",
          "schedule_at": "{{components.adsScheduleAt.value || null}}"
        }
      },
      "run_on_page_load": false,
      "options_extra": { "timeout_ms": 420000 }
    },
    {
      "name": "list_shops_with_status",
      "data_source": "etsy_app_db",
      "kind": "postgresql",
      "options": {
        "query": "SELECT id, name, etsy_shop_id, CASE WHEN oauth_token IS NOT NULL AND token_expires > now() THEN 'connected' WHEN oauth_token IS NOT NULL THEN 'expired' ELSE 'not_connected' END AS status, pod_provider, pod_shop_id, last_synced_at, token_expires FROM shops ORDER BY id;"
      },
      "run_on_page_load": true
    },
    {
      "name": "list_orders",
      "data_source": "etsy_app_db",
      "kind": "postgresql",
      "options": {
        "query": "SELECT o.id, s.name AS shop, o.etsy_order_id, o.status, o.total, o.pod_provider, o.pod_order_id, o.error, o.created_at FROM orders o JOIN shops s ON s.id = o.shop_id ORDER BY o.created_at DESC LIMIT 200;"
      },
      "run_on_page_load": true
    },
    {
      "name": "reroute_order",
      "data_source": "n8n_api",
      "kind": "restapi",
      "options": {
        "method": "post",
        "url_path": "/webhook/pod-route",
        "body_toggle": true,
        "json_body": { "order_id": "{{components.ordersTable.selectedRow?.id}}" }
      },
      "run_on_page_load": false
    },
    {
      "name": "start_etsy_connect",
      "data_source": "n8n_api",
      "kind": "restapi",
      "options": {
        "method": "get",
        "url_path": "/webhook/etsy-connect",
        "url_params": [
          { "key": "shop_name", "value": "{{components.newShopName.value || 'My Shop'}}" }
        ]
      },
      "run_on_page_load": false
    },
    {
      "name": "save_shop_pod_config",
      "data_source": "etsy_app_db",
      "kind": "postgresql",
      "options": {
        "query": "UPDATE shops SET pod_provider = NULLIF($1::text, ''), pod_shop_id = NULLIF($2::text, '') WHERE id = $3 RETURNING id, pod_provider, pod_shop_id;",
        "params": [
          "{{components.shopPodProviderSelect.value}}",
          "{{components.shopPodShopIdInput.value}}",
          "{{components.shopsTable.selectedRow?.id}}"
        ]
      },
      "run_on_page_load": false
    }
  ],
  "pages": [
    {
      "id": "dashboard",
      "name": "Dashboard",
      "is_home": true,
      "components": [
        { "id": "h1", "type": "Text", "props": { "text": "Etsy AI Dashboard" } },
        { "id": "kpiRevenue", "type": "StatisticsCard", "props": { "label": "Revenue today (USD)", "value": "{{queries.kpi_today.data[0].revenue}}" } },
        { "id": "kpiOrders",  "type": "StatisticsCard", "props": { "label": "Orders today",        "value": "{{queries.kpi_today.data[0].orders}}" } },
        { "id": "kpiProfit",  "type": "StatisticsCard", "props": { "label": "Profit today (USD)",  "value": "{{queries.kpi_today.data[0].profit}}" } }
      ]
    },
    {
      "id": "ai-tools",
      "name": "AI Tools",
      "components": [
        { "id": "title", "type": "Text", "props": { "text": "AI Listing Generator" } },
        {
          "id": "shopSelect", "type": "Dropdown",
          "props": {
            "label": "Shop",
            "values_source": "{{queries.list_shops.data.map(s => s.id)}}",
            "labels_source": "{{queries.list_shops.data.map(s => s.name)}}",
            "default_value": "{{constants.DEFAULT_SHOP_ID}}"
          }
        },
        { "id": "nicheInput", "type": "TextInput", "props": { "label": "Niche / description", "placeholder": "e.g. vintage botanical printables" } },
        {
          "id": "kindSelect", "type": "Dropdown",
          "props": { "label": "Kind", "values": ["printable", "pod"], "default_value": "printable" }
        },
        { "id": "costInput", "type": "NumberInput", "props": { "label": "Cost (USD, POD only)", "default_value": 0 } },
        {
          "id": "generateBtn", "type": "Button",
          "props": { "text": "Generate", "loading_state": "{{queries.generate_listing.isLoading}}" },
          "events": [{ "event": "onClick", "action": "run-query", "query": "generate_listing" }]
        },
        { "id": "resultTitle",       "type": "Text", "props": { "text": "Title: {{queries.generate_listing.data.listing.title}}" } },
        { "id": "resultTags",        "type": "Text", "props": { "text": "Tags: {{queries.generate_listing.data.listing.tags?.join(', ')}}" } },
        { "id": "resultPrice",       "type": "Text", "props": { "text": "Suggested price: ${{queries.generate_listing.data.listing.price}}" } },
        { "id": "resultDescription", "type": "TextArea", "props": { "value": "{{queries.generate_listing.data.listing.description}}", "rows": 8, "read_only": true } },
        {
          "id": "publishBtn", "type": "Button",
          "props": { "text": "Publish to Etsy", "disabled": "{{!queries.generate_listing.data?.listing?.id}}" },
          "events": [{ "event": "onClick", "action": "run-query", "query": "publish_listing" }]
        }
      ]
    },
    {
      "id": "ai-visual",
      "name": "AI Visual Studio",
      "components": [
        { "id": "vsTitle", "type": "Text", "props": { "text": "Generate mockups for a listing" } },
        {
          "id": "visualListingSelect", "type": "Dropdown",
          "props": {
            "label": "Listing",
            "values_source": "{{queries.list_listings_for_visual.data.map(l => l.id)}}",
            "labels_source": "{{queries.list_listings_for_visual.data.map(l => l.title)}}"
          }
        },
        { "id": "visualPromptInput", "type": "TextArea", "props": { "label": "Prompt override (optional)", "placeholder": "Leave blank to auto-build from the listing.", "rows": 3 } },
        {
          "id": "visualSizeSelect", "type": "Dropdown",
          "props": { "label": "Size", "values": ["768", "1024", "1280"], "labels": ["768²", "1024²", "1280²"], "default_value": "1024" }
        },
        {
          "id": "visualCheckpointSelect", "type": "Dropdown",
          "props": {
            "label": "Checkpoint",
            "values": ["sd_xl_base_1.0.safetensors", "flux1-dev.safetensors"],
            "labels": ["SDXL base 1.0", "Flux dev"],
            "default_value": "sd_xl_base_1.0.safetensors"
          }
        },
        {
          "id": "generateVisualBtn", "type": "Button",
          "props": { "text": "Generate", "loading_state": "{{queries.generate_visual.isLoading}}" },
          "events": [
            { "event": "onClick", "action": "run-query", "query": "generate_visual" },
            { "event": "onSuccess", "action": "run-query", "query": "list_mockups" }
          ]
        },
        {
          "id": "visualResult", "type": "Image",
          "props": {
            "source": "{{queries.generate_visual.data?.view_url ? constants.N8N_URL + queries.generate_visual.data.view_url : ''}}",
            "alt_text": "Latest generated mockup",
            "visible": "{{!!queries.generate_visual.data?.view_url}}"
          }
        },
        {
          "id": "mockupGallery", "type": "ListView",
          "props": {
            "data": "{{queries.list_mockups.data}}",
            "row_template": [
              { "type": "Image", "props": { "source": "{{constants.N8N_URL}}/webhook/mockup-view?id={{listItem.id}}", "alt_text": "{{listItem.title}}" } },
              { "type": "Text",  "props": { "text": "#{{listItem.id}} · listing {{listItem.listing_id}} · {{listItem.created_at}}" } }
            ]
          }
        }
      ]
    },
    {
      "id": "shops",
      "name": "Shops",
      "components": [
        { "id": "shopsTitle", "type": "Text", "props": { "text": "Connect an Etsy shop" } },
        { "id": "newShopName", "type": "TextInput", "props": { "label": "Shop label (free text)", "placeholder": "My Test Shop" } },
        {
          "id": "connectShopBtn", "type": "Button",
          "props": { "text": "Authorise on Etsy", "loading_state": "{{queries.start_etsy_connect.isLoading}}" },
          "events": [
            { "event": "onClick", "action": "run-query", "query": "start_etsy_connect" },
            { "event": "onSuccess", "action": "open-url",
              "url": "{{queries.start_etsy_connect.data?.auth_url}}",
              "open_in_new_tab": true }
          ]
        },
        { "id": "shopsTableTitle", "type": "Text", "props": { "text": "Connected shops" } },
        {
          "id": "shopsTable", "type": "Table",
          "props": {
            "data": "{{queries.list_shops_with_status.data}}",
            "columns": [
              { "key": "id", "name": "ID" },
              { "key": "name", "name": "Name" },
              { "key": "etsy_shop_id", "name": "Etsy shop id" },
              { "key": "status", "name": "Status" },
              { "key": "pod_provider", "name": "POD" },
              { "key": "pod_shop_id", "name": "POD shop id" },
              { "key": "last_synced_at", "name": "Last sync" },
              { "key": "token_expires", "name": "Token expires" }
            ]
          }
        },
        { "id": "podConfigTitle", "type": "Text", "props": { "text": "POD provider for selected shop" } },
        {
          "id": "shopPodProviderSelect", "type": "Dropdown",
          "props": {
            "label": "Provider",
            "values": ["", "printify", "printful"],
            "labels": ["(none)", "Printify", "Printful"],
            "default_value": "{{components.shopsTable.selectedRow?.pod_provider || ''}}"
          }
        },
        {
          "id": "shopPodShopIdInput", "type": "TextInput",
          "props": {
            "label": "POD shop / store id",
            "placeholder": "Printify shop id, or Printful store id",
            "default_value": "{{components.shopsTable.selectedRow?.pod_shop_id || ''}}"
          }
        },
        {
          "id": "savePodConfigBtn", "type": "Button",
          "props": { "text": "Save POD config", "disabled": "{{!components.shopsTable.selectedRow}}" },
          "events": [
            { "event": "onClick", "action": "run-query", "query": "save_shop_pod_config" },
            { "event": "onSuccess", "action": "run-query", "query": "list_shops_with_status" }
          ]
        }
      ]
    },
    {
      "id": "ai-ads",
      "name": "AI Ads Studio",
      "components": [
        { "id": "adsTitle", "type": "Text", "props": { "text": "Generate channel-specific ad copy + queue posts" } },
        {
          "id": "adsListingSelect", "type": "Dropdown",
          "props": {
            "label": "Listing",
            "values_source": "{{queries.list_listings_for_ads.data.map(l => l.id)}}",
            "labels_source": "{{queries.list_listings_for_ads.data.map(l => l.title)}}"
          }
        },
        {
          "id": "adsChannelsMulti", "type": "Multiselect",
          "props": {
            "label": "Channels",
            "values": ["pinterest", "x", "instagram"],
            "labels": ["Pinterest", "X", "Instagram"],
            "default_value": ["pinterest", "x", "instagram"]
          }
        },
        {
          "id": "adsGenerateVisual", "type": "ToggleSwitch",
          "props": { "label": "Also generate a 1080² visual", "default_value": false }
        },
        {
          "id": "adsScheduleAt", "type": "DatetimePicker",
          "props": { "label": "Schedule for (optional, default = +1 hour)" }
        },
        {
          "id": "generateAdsBtn", "type": "Button",
          "props": { "text": "Generate + queue", "loading_state": "{{queries.generate_ads.isLoading}}" },
          "events": [
            { "event": "onClick",   "action": "run-query", "query": "generate_ads" },
            { "event": "onSuccess", "action": "run-query", "query": "list_scheduled_posts" }
          ]
        },
        {
          "id": "adsResult", "type": "Text",
          "props": {
            "text": "Queued: {{(queries.generate_ads.data?.scheduled || []).map(p => p.channel).join(', ')}}",
            "visible": "{{queries.generate_ads.data?.ok}}"
          }
        },
        {
          "id": "scheduledTable", "type": "Table",
          "props": {
            "data": "{{queries.list_scheduled_posts.data}}",
            "columns": [
              { "key": "id", "name": "ID" },
              { "key": "title", "name": "Listing" },
              { "key": "channel", "name": "Channel" },
              { "key": "status", "name": "Status" },
              { "key": "scheduled_for", "name": "Scheduled for" },
              { "key": "preview", "name": "Copy preview" }
            ]
          }
        }
      ]
    },
    {
      "id": "listings",
      "name": "Listings",
      "components": [
        {
          "id": "listingsTable", "type": "Table",
          "props": {
            "data": "{{queries.list_listings.data}}",
            "columns": [
              { "key": "id", "name": "ID" },
              { "key": "shop", "name": "Shop" },
              { "key": "title", "name": "Title" },
              { "key": "kind", "name": "Kind" },
              { "key": "price", "name": "Price" },
              { "key": "status", "name": "Status" },
              { "key": "created_at", "name": "Created" }
            ]
          }
        }
      ]
    },
    {
      "id": "orders",
      "name": "Orders",
      "components": [
        { "id": "ordersTitle", "type": "Text", "props": { "text": "Synced Etsy orders + POD routing status" } },
        {
          "id": "ordersTable", "type": "Table",
          "props": {
            "data": "{{queries.list_orders.data}}",
            "columns": [
              { "key": "id", "name": "ID" },
              { "key": "shop", "name": "Shop" },
              { "key": "etsy_order_id", "name": "Etsy receipt" },
              { "key": "status", "name": "Status" },
              { "key": "total", "name": "Total" },
              { "key": "pod_provider", "name": "POD" },
              { "key": "pod_order_id", "name": "POD order id" },
              { "key": "error", "name": "Error" },
              { "key": "created_at", "name": "Created" }
            ]
          }
        },
        {
          "id": "syncBtn", "type": "Button",
          "props": { "text": "Re-route selected order via wf 07" },
          "events": [
            { "event": "onClick", "action": "run-query", "query": "reroute_order" },
            { "event": "onSuccess", "action": "run-query", "query": "list_orders" }
          ]
        }
      ]
    },
    {
      "id": "analytics",
      "name": "Analytics",
      "components": [
        { "id": "analyticsStub", "type": "Text", "props": { "text": "Analytics tab — implements multi-shop revenue / profit charts in v2 once order sync is live." } }
      ]
    }
  ]
}
